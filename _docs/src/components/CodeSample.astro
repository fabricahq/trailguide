---
/** @fileoverview Renders escaped, build-time syntax highlighting with restrained colors that follow the site theme. */
import { Code } from 'astro:components';
import { createCssVariablesTheme } from 'shiki';

/** Source text, its grammar, and an accessible description; plain samples retain the same readable typography. */
interface Props {
  code: string;
  lang: 'ts' | 'md' | 'diff' | 'text';
  label: string;
  tone?: 'default' | 'muted' | 'terminal' | 'vivid';
}
const { code, lang, label, tone = 'default' } = Astro.props;
const theme = createCssVariablesTheme({ variablePrefix: '--sample-', fontStyle: false });
---
<div class:list={["code-sample", { muted: tone === "muted", terminal: tone === "terminal", vivid: tone === "vivid" }]}>
  <Code code={code} lang={lang} embeddedLangs={lang === 'md' ? ['yaml'] : []} theme={theme} wrap={true} aria-label={label} tabindex="0" />
</div>
<style>
  .code-sample {
    min-width: 0;
    --sample-foreground: var(--cr-ink);
    --sample-background: transparent;
    --sample-token-constant: #c4af97;
    --sample-token-string: #a6baa4;
    --sample-token-comment: var(--cr-muted);
    --sample-token-keyword: #b7a4bd;
    --sample-token-parameter: var(--cr-ink);
    --sample-token-function: #9aafbc;
    --sample-token-string-expression: #a6baa4;
    --sample-token-punctuation: var(--cr-muted);
    --sample-token-link: #9aafbc;
  }
  :global([data-theme='light']) .code-sample {
    --sample-token-constant: #865b47;
    --sample-token-string: #526956;
    --sample-token-keyword: #735977;
    --sample-token-function: #4a6575;
    --sample-token-string-expression: #526956;
    --sample-token-link: #4a6575;
  }
  .code-sample.muted {
    --sample-foreground: var(--cr-muted);
  }
  .code-sample.vivid {
    --sample-token-constant: #79c0ff;
    --sample-token-string: #a5d6ff;
    --sample-token-comment: #8b949e;
    --sample-token-keyword: #ff7b72;
    --sample-token-function: #d2a8ff;
    --sample-token-string-expression: #a5d6ff;
    --sample-token-punctuation: #c9d1d9;
    --sample-token-link: #58a6ff;
  }
  :global([data-theme='light']) .code-sample.vivid {
    --sample-token-constant: #005cc5;
    --sample-token-string: #032f62;
    --sample-token-comment: #626b75;
    --sample-token-keyword: #cc3344;
    --sample-token-function: #6f42c1;
    --sample-token-string-expression: #032f62;
    --sample-token-punctuation: #24292e;
    --sample-token-link: #0366d6;
  }
  /* This tone is self-contained; syntax colors do not inherit session status colors. */
  .code-sample.terminal {
    --sample-foreground: #e1e9f5;
    --sample-token-constant: #eac483;
    --sample-token-string: #80d9b2;
    --sample-token-comment: #99aac2;
    --sample-token-keyword: #c5a4ff;
    --sample-token-parameter: #e1e9f5;
    --sample-token-function: #7fc5ff;
    --sample-token-string-expression: #80d9b2;
    --sample-token-punctuation: #99aac2;
    --sample-token-link: #7fc5ff;
  }
  :global([data-theme='light']) .code-sample.terminal {
    --sample-foreground: #23324a;
    --sample-token-constant: #966022;
    --sample-token-string: #267553;
    --sample-token-comment: #5b6d87;
    --sample-token-keyword: #7850ae;
    --sample-token-parameter: #23324a;
    --sample-token-function: #216bb0;
    --sample-token-string-expression: #267553;
    --sample-token-punctuation: #5b6d87;
    --sample-token-link: #216bb0;
  }
  .code-sample :global(pre.astro-code) { margin: 0; padding: var(--sample-padding, 1.25rem); border: 0; background: transparent; font: var(--sample-font-size, .78rem)/1.8 var(--cr-font-mono); white-space: pre-wrap; overflow: auto; overflow-wrap: anywhere; tab-size: 2; }
  .code-sample :global(pre code) { font: inherit; color: inherit; background: none; padding: 0; border: 0; }
</style>
