{
  "name": "trailguide-website-tools",
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "docs:dev": "bun run --cwd docs dev",
    "docs:check": "bun run --cwd docs check",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "docs:links:all": "bun docs/_tools/link-checker/cli.ts --external",
    "docs:links": "bun run --cwd docs links",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run docs:check && bun run docs:build && bun run docs:links",
    "format:check": "prettier --single-quote --check _tools/*.ts \"docs/_tools/**/*.ts\" eslint.config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "bun test ./_tools ./docs/_tools"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@typescript-eslint/parser": "^8.70.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.5.3",
    "prettier": "^3.9.8",
    "typescript": "6.0.3",
    "yaml": "^2.9.1"
  },
  "private": true
}
