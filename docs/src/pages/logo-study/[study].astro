---
/** @fileoverview Renders a development-only logo comparison page with size samples and a background-theme toggle. */

import '../../styles/custom.css';
import { seed, mappingMethod } from '../../components/SeededLogoStudies';
import { vectorLogos } from '../../components/VectorLogoStudies';
import { socketLogos } from '../../components/SocketLogoStudies';
import { smallLogos } from '../../components/SmallLogoStudies';
import { logoStudies, logoStudy } from '../../components/LogoStudy';
import extrude from '../../assets/fabrica-logo-study/extrude.png';
import sweep from '../../assets/fabrica-logo-study/sweep-refined.png';
/** Return the five logo-study routes in development and no routes in production builds. */
export function getStaticPaths() {
  return import.meta.env.DEV ? logoStudies.map(({ id }) => ({ params: { study: id } })) : [];
}
const study = logoStudy(Astro.params.study);
const favorites = [
  { id: 'extrude', name: 'Extrude', description: 'Broad, folded bands.', src: extrude.src, scale: 125, position: '50% 50%' },
  { id: 'sweep', name: 'Sweep', description: 'Three tools turning together.', src: sweep.src, scale: 120, position: '50% 50%' },
];
---
<!doctype html>
<html lang="en" data-theme="light">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Fabrica / {study.pageTitle}</title></head>
  <body>
    <header class="lab-header">
      <a class="home-link" href="/?variant=sweep"><span>Fabrica</span><span class="slash">/</span><strong>Logo study</strong></a>
      <button type="button" id="theme-toggle" aria-pressed="false">Dark background</button>
    </header>
    <main>
      <div class="intro"><p class="eyebrow">{study.eyebrow}</p><h1>{study.title}</h1><p class="lead">{study.description}</p><a class="overview-link" href={study.next.href}>{study.next.label}</a></div>
      {study.showRecipe && <section aria-labelledby="favorites-title" class="favorites-section">
        <div class="section-heading"><h2 id="favorites-title">Your favorites so far</h2><span>Unchanged</span></div>
        <div class="favorites">
          {favorites.map(item => <a class="favorite" href={`/?variant=${item.id}`} style={`--mark: url("${item.src}"); --mask-scale: ${item.scale}%; --mask-position: ${item.position}; --mask-mode: ${item.id.startsWith('tinker-') ? 'luminance' : 'alpha'}; --small-ink: ${[...smallLogos, ...socketLogos, ...vectorLogos].some(logo => logo.id === item.id) ? 'var(--cr-ink)' : 'var(--cr-muted)'}`}><span class="mark medium" aria-hidden="true"></span><div><h3>{item.name}</h3><p>{item.description}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}
        </div>
      </section>}
      {study.reference && <div class="reference-strip" style={`--mark: url(${study.reference.src}); --mask-scale: ${study.reference.scale}%; --mask-position: ${study.reference.position}; --mask-mode: luminance`}><span>Previous Beam</span>{[32,16,12,8].map(size => <span class="mark" style={`width:${size}px;height:${size}px`} aria-hidden="true"></span>)}<a href="/?variant=tinker-beam">Try original ↗</a></div>}
      <section aria-labelledby="concepts-title">
        <div class="section-heading"><h2 id="concepts-title">{study.sectionTitle}</h2><span>{study.smallSamples ? '16px / 12px / 8px' : 'Large silhouette + actual 16px header mark'}</span></div>
        <div class="concept-grid">
          {study.concepts.map((item, index) => <article class="concept" style={`--mark: url("${item.src}"); --mask-scale: ${item.scale}%; --mask-position: ${item.position}; --mask-mode: ${item.id.startsWith('tinker-') ? 'luminance' : 'alpha'}; --small-ink: ${[...smallLogos, ...socketLogos, ...vectorLogos].some(logo => logo.id === item.id) ? 'var(--cr-ink)' : 'var(--cr-muted)'}`}>
            <div class="card-heading"><span class="number">{String(index + 1).padStart(2, '0')}</span><h3>{item.name}</h3></div>
            <div class="art-stage"><span class="mark large" aria-hidden="true"></span><span class="reverse-sample"><span class="mark" aria-hidden="true"></span></span></div>
            {study.smallSamples && <div class="size-samples">{[16, 12, 8].map(size => <div><span class="mark" style={`width:${size}px;height:${size}px`} aria-hidden="true"></span><span>{size}px</span></div>)}</div>}
            <div class="header-sample" aria-label={`${item.name} at 16 pixels`}><span class="mark tiny" aria-hidden="true"></span><span class="parent-name">Fabrica</span><span class="slash">/</span><strong>Trail Guide</strong></div>
            <p class="description">{item.description}</p>
            {item.combination && <details><summary>Idea combination</summary><p>{item.combination.metaphor}<br /><span>+</span> {item.combination.form}<br /><span>+</span> {item.combination.character}</p><code>{item.combination.chunk}</code></details>}
            <a class="try-link" href={`/?variant=${item.id}`}>Try in the docs header <span aria-hidden="true">↗</span></a>
          </article>)}
        </div>
      </section>
      {study.showRecipe && <details class="method"><summary>How the random seed shaped this round</summary><code class="seed">{seed}</code><p>{mappingMethod}</p><p>Each combination became an art direction, then a generated image. The mapping is repeatable; image generation is not deterministic. All marks share one finishing cue: an unexpected offset.</p></details>}
      {study.smallSamples && <p class="size-note">At a 16px header size, 75% zoom leaves 12px and 50% leaves 8px. The new marks also use stronger contrast. These samples show those dimensions; the docs preview also lets you scale the full header branding.</p>}
      <footer>Temporary exploration. No logo has final approval.</footer>
    </main>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
      button?.addEventListener('click', () => {
        const dark = document.documentElement.dataset.theme !== 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        button.setAttribute('aria-pressed', String(dark));
        button.textContent = dark ? 'Light background' : 'Dark background';
      });
    </script>
  </body>
</html>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--cr-ink); background: var(--cr-paper); font-family: var(--sl-font); }
  a { color: inherit; text-decoration: none; }
  .lab-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem max(24px, calc((100vw - 1280px) / 2)); border-bottom: 1px solid var(--cr-border); }
  .home-link { display: flex; align-items: baseline; gap: .6rem; white-space: nowrap; font-size: 1rem; letter-spacing: -.03em; }
  .home-link > span:first-child { font-size: .85rem; color: var(--cr-muted); }
  .slash { color: var(--cr-muted); }
  button { font: inherit; font-size: .8rem; padding: .65rem .85rem; color: var(--cr-ink); background: transparent; border: 1px solid var(--cr-border); border-radius: 8px; cursor: pointer; }
  button:hover { background: var(--cr-surface); }
  main { max-width: 1328px; margin: auto; padding: 3.5rem 24px 1.5rem; }
  .intro { margin-bottom: 2.7rem; }
  .eyebrow { font-size: .65rem; letter-spacing: .14em; color: var(--cr-muted); }
  h1 { font-weight: 500; font-size: clamp(2rem,4.5vw,3.5rem); letter-spacing: -.05em; line-height: 1.1; margin: .8rem 0 1rem; }
  .overview-link { font-size: .8rem; color: var(--cr-muted); }
  .overview-link:hover { color: var(--cr-ink); }
  .lead { font-size: 1rem; line-height: 1.7; color: var(--cr-muted); }
  .section-heading { display: flex; gap: 1rem; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; }
  h2 { font-size: 1rem; font-weight: 600; margin: 0; letter-spacing: -.025em; }
  .section-heading > span { font-size: .7rem; color: var(--cr-muted); }
  .favorites { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  .favorite { display: flex; align-items: center; gap: 1.5rem; border: 1px solid var(--cr-border); padding: 1.4rem; border-radius: 12px; min-width: 0; }
  .favorite:hover { background: var(--cr-surface); }
  h3 { font-size: .95rem; font-weight: 600; letter-spacing: -.02em; margin: 0; }
  .favorite p { color: var(--cr-muted); font-size: .8rem; margin: .35rem 0 0; }
  .arrow { margin-left: auto; }
  .favorites-section { margin-bottom: 3rem; }
  .concept-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1rem; }
  .concept { min-width: 0; display: flex; flex-direction: column; padding: 1.15rem; border: 1px solid var(--cr-border); border-radius: 12px; }
  .card-heading { display: flex; align-items: baseline; gap: .55rem; }
  .number { color: var(--cr-muted); font-family: var(--cr-font-mono); font-size: .65rem; }
  .reference-strip { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; border-block: 1px solid var(--cr-border); padding: 1.2rem 0; margin-bottom: 2rem; font-size: .75rem; }
  .reference-strip > span:first-child { color: var(--cr-muted); }
  .reference-strip a { margin-left: auto; }
  .size-samples { display: flex; justify-content: space-around; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--cr-border-subtle); }
  .size-samples > div { display: flex; min-height: 40px; flex-direction: column; align-items: center; justify-content: space-between; gap: .6rem; color: var(--cr-muted); font-size: .65rem; }
  .size-samples .mark { color: var(--small-ink); }
  .size-note { color: var(--cr-muted); font-size: .8rem; line-height: 1.6; margin-top: 1.5rem; }
  .art-stage { position: relative; height: 176px; display: flex; align-items: center; justify-content: center; margin: .5rem 0; }
  .mark { display: block; flex-shrink: 0; width: 28px; height: 28px; background: currentColor; mask: var(--mark) var(--mask-position,50% 50%) / var(--mask-scale,120%) no-repeat; mask-mode: var(--mask-mode, alpha); }
  .mark.large { width: 96px; height: 96px; }
  .mark.medium { width: 48px; height: 48px; }
  .mark.tiny { width: 16px; height: 16px; color: var(--small-ink, var(--cr-muted)); }
  .reverse-sample { position: absolute; bottom: 4px; right: 0; width: 42px; height: 42px; display: grid; place-items: center; color: var(--cr-paper); background: var(--cr-ink); border-radius: 7px; }
  .header-sample { display: flex; align-items: baseline; gap: .35rem; padding: 1rem 0; border-top: 1px solid var(--cr-border-subtle); border-bottom: 1px solid var(--cr-border-subtle); white-space: nowrap; letter-spacing: -.035em; font-size: 14px; }
  .header-sample .mark { align-self: center; }
  .parent-name { color: var(--cr-muted); font-size: 12px; }
  .header-sample strong { font-weight: 650; }
  .description { color: var(--cr-muted); font-size: .8rem; line-height: 1.55; min-height: 2.5rem; margin: 1rem 0; }
  details { font-size: .72rem; line-height: 1.6; color: var(--cr-muted); }
  summary { cursor: pointer; }
  details p { margin: .75rem 0; }
  details code { font-family: var(--cr-font-mono); font-size: .7rem; }
  .try-link { margin-top: auto; padding-top: 1.3rem; display: flex; justify-content: space-between; gap: .5rem; font-size: .75rem; font-weight: 550; }
  .try-link:hover { color: var(--cr-muted); }
  .method { margin-top: 2rem; padding: 1.3rem; border: 1px solid var(--cr-border); border-radius: 10px; max-width: 100%; }
  .method .seed { display: block; margin: 1rem 0; overflow-wrap: anywhere; }
  footer { color: var(--cr-muted); font-size: .7rem; margin-top: 2rem; }
  @media(max-width:1120px) { .concept-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  @media(max-width:850px) { .concept-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(max-width:540px) { .concept-grid,.favorites { grid-template-columns: minmax(0,1fr); } .section-heading { align-items: flex-start; flex-direction: column; gap: .4rem; } .lab-header { padding-inline:16px; } main { padding:2rem 16px; } .art-stage { height:180px; } .favorite { padding:1rem; } .header-sample { justify-content:center; } }
</style>
