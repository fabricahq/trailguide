---
/** @fileoverview Plays the narrated Trail Guide tour on the homepage at 1.1x by default, with a large play button and buttons to change the speed. */
const SPEEDS = [1, 1.1, 1.25, 1.5, 2] as const;
const DEFAULT_SPEED = 1.1;
// Versioned URLs prevent browsers from reusing a cached export after replacement.
const TOUR_SRC = '/video/trailguide-tour.mp4?v=55d06b55bf4a';
---
<figure class="mx-auto my-0 max-w-[60rem] py-6 max-md:py-4" aria-label="Trail Guide tour video" data-tour-video data-default-speed={DEFAULT_SPEED}>
  <div class="relative">
    <video class="block w-full h-auto aspect-video rounded-panel border border-border bg-[#151515]" controls preload="metadata" playsinline poster="/video/trailguide-tour-poster.svg?v=2" width="1920" height="1080">
      <source src={TOUR_SRC} type="video/mp4" />
      <a href={TOUR_SRC}>Download the Trail Guide tour</a>.
    </video>
    <!-- The poster is dark, so the browser's own play control is hard to see until the video starts. -->
    <button type="button" class="absolute inset-0 m-auto grid [&[hidden]]:hidden place-items-center size-20 rounded-full border-0 bg-white text-[#151515] shadow-[0_8px_30px_#0008] cursor-pointer motion-safe:transition-transform hover:scale-105 focus-visible:outline-3 focus-visible:outline-white focus-visible:outline-offset-4 max-sm:size-14" aria-label="Play the Trail Guide tour" hidden data-tour-play>
      <svg class="size-9 ml-1 max-sm:size-6" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l12.5-7.5Z" /></svg>
    </button>
  </div>
  <figcaption class="flex flex-wrap items-center justify-center gap-2 mt-4">
    <span class="cr-index mr-1" id="tour-speed-label">SPEED</span>
    <div class="flex flex-wrap gap-2" role="group" aria-labelledby="tour-speed-label">
      {SPEEDS.map(speed => (
        <button type="button" class="min-h-8 px-3 py-1 border border-border rounded-full bg-transparent text-muted text-xs font-medium cursor-pointer hover:text-ink hover:border-ink focus-visible:outline-2 focus-visible:outline-ink focus-visible:outline-offset-2 aria-pressed:bg-surface aria-pressed:text-ink aria-pressed:border-ink" data-speed={speed} aria-pressed={speed === DEFAULT_SPEED ? 'true' : 'false'}>{speed}×</button>
      ))}
    </div>
  </figcaption>
</figure>
<script>
  for (const figure of document.querySelectorAll<HTMLElement>('[data-tour-video]')) {
    const video = figure.querySelector('video');
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>('[data-speed]')];
    if (video === null) continue;
    const defaultSpeed = Number(figure.dataset.defaultSpeed);
    // Browsers reset playbackRate when a source loads, so set the default rate too.
    video.defaultPlaybackRate = defaultSpeed;
    video.playbackRate = defaultSpeed;
    const showSpeed = () => {
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(Number(button.dataset.speed) === video.playbackRate));
      }
    };
    video.addEventListener('ratechange', showSpeed);
    const play = figure.querySelector<HTMLButtonElement>('[data-tour-play]');
    if (play !== null) {
      play.hidden = false;
      play.addEventListener('click', () => void video.play());
      video.addEventListener('play', () => { play.hidden = true; }, { once: true });
    }
    for (const button of buttons) {
      button.addEventListener('click', () => {
        video.playbackRate = Number(button.dataset.speed);
        showSpeed();
      });
    }
  }
</script>
